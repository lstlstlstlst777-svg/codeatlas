# 三槽位配置：同一把 key 可覆盖 embedding / rerank / LLM
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=replace-me
LLM_MODEL=Qwen/Qwen3-8B

EMB_BASE_URL=https://api.siliconflow.cn/v1
EMB_API_KEY=replace-me
EMB_MODEL=BAAI/bge-m3

RR_BASE_URL=https://api.siliconflow.cn/v1
RR_API_KEY=replace-me
RR_MODEL=BAAI/bge-reranker-v2-m3

# live = 真实调用；fake = 确定性假实现（CI 用）
PROVIDER_MODE=live

# 观测
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
